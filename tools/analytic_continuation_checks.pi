"""Compile and validate the analytic-continuation bounded-loop contract."""
import shutil
import re
import subprocess
import sys
import tempfile
from pathlib import Path
from builtins import AssertionError, SystemExit

ROOT ∈ object ← Path(__file__).resolve().parent.parent
BACKEND ∈ object ← ROOT.joinpath("build", "exec", "idris2-glsles")
VERTEX ∈ object ← ROOT.joinpath("fixtures", "wegert-fullscreen.vert")
SOURCE ∈ str ← "src/Example/AnalyticContinuation.idr"

def require(condition ∈ bool, message ∈ str) → None:
    if not condition:
        raise AssertionError(message)

def compile_variant(output_dir ∈ object, precision ∈ str) → tuple[str, str, object]:
    output_name ∈ str ← "analytic-continuation-" + precision
    ir_path ∈ object ← output_dir.joinpath(output_name + ".ir")
    result ∈ object ← subprocess.run(
        [str(BACKEND), "--cg", "glsles", "--source-dir", "src",
         "--output-dir", str(output_dir), "--directive", "dump-ir=" + str(ir_path),
         "--directive", "float-precision=" + precision, SOURCE, "-o", output_name],
        cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
    result_status ∈ int ← result.returncode
    result_output ∈ str ← result.stdout
    require(result_status == 0, "analytic continuation " + precision + " shader failed:\n" + result_output)
    shader_path ∈ object ← output_dir.joinpath(output_name + ".frag")
    require(shader_path.is_file(), "backend did not write " + str(shader_path.name))
    require(ir_path.is_file(), "backend did not write " + str(ir_path.name))
    ir ∈ str ← ir_path.read_text()
    shader ∈ str ← shader_path.read_text()
    return ir, shader, shader_path

def normalize_precision(shader ∈ str) → str:
    return shader.replace("precision lowp float;", "precision FLOAT_POLICY float;").replace(
        "precision highp float;", "precision FLOAT_POLICY float;")

def loop_blocks(shader ∈ str) → list[str]:
    blocks ∈ list[str] ← []
    cursor ∈ int ← 0
    while True:
        start ∈ int ← shader.find("for (int ", cursor)
        if start < 0:
            return blocks
        open_brace ∈ int ← shader.find("{", start)
        require(open_brace >= 0, "bounded GLSL loop has no body")
        depth ∈ int ← 1
        index ∈ int ← open_brace + 1
        while index < len(shader) and depth:
            if shader[index] == "{":
                depth = depth + 1
            elif shader[index] == "}":
                depth = depth - 1
            index = index + 1
        require(depth == 0, "bounded GLSL loop body is unbalanced")
        blocks.append(shader[start:index])
        cursor = index

def validate_glsl(shader_path ∈ object) → None:
    validator ∈ str | None ← shutil.which("glslangValidator")
    if validator:
        fragment ∈ object ← subprocess.run(
            [validator, "-S", "frag", str(shader_path)], cwd=ROOT, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
        fragment_status ∈ int ← fragment.returncode
        fragment_output ∈ str ← fragment.stdout
        require(fragment_status == 0,
                "GLSL validator rejected analytic continuation fragment:\n" + fragment_output)
        linked ∈ object ← subprocess.run(
            [validator, "-l", str(VERTEX), str(shader_path)], cwd=ROOT, text=True,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False)
        linked_status ∈ int ← linked.returncode
        linked_output ∈ str ← linked.stdout
        require(linked_status == 0,
                "Wegert vertex and analytic continuation fragment did not link:\n" + linked_output)

def check_shader_shape(shader ∈ str, precision ∈ str) → None:
    require("precision " + precision + " float;" in shader,
            "analytic continuation did not request " + precision)
    for declaration in ["uniform vec2 u_resolution;", "uniform int u_zero_count;",
                        "uniform int u_pole_count;", "uniform vec2 u_zeros[64];",
                        "uniform vec2 u_poles[64];", "uniform int u_view_kind;",
                        "uniform int u_continuation_count;",
                        "uniform vec2 u_continuation_centers[24];",
                        "uniform float u_continuation_radii[24];"]:
        require(declaration in shader, "analytic continuation interface lost " + declaration)
    loops ∈ list[str] ← loop_blocks(shader)
    require(len(loops) == 2, "analytic continuation must emit exactly two bounded factor loops")
    loop_cap_count ∈ int ← shader.count(" < 64 && ")
    require(loop_cap_count == 2,
            "factor loops lost their compile-time 64-element maximum")
    zero_readers ∈ int ← 0
    pole_readers ∈ int ← 0
    shader_lines ∈ list[str] ← shader.splitlines()
    for block in loops:
        active_uniform ∈ str ← ""
        if "u_zeros[int(" in block:
            zero_readers = zero_readers + 1
            active_uniform = "u_zero_count"
        if "u_poles[int(" in block:
            pole_readers = pole_readers + 1
            require(active_uniform == "", "one factor loop reads both arrays")
            active_uniform = "u_pole_count"
        require(active_uniform != "", "factor loop has no active array")
        active_name ∈ str ← ""
        for declaration_line in shader_lines:
            if active_name == "" and " = float(" + active_uniform + ");" in declaration_line:
                declaration_words ∈ list[str] ← declaration_line.split()
                active_name = declaration_words[1]
        require(active_name != "", active_uniform + " runtime active bound has no conversion")
        require(" < " + active_name + ";" in block,
                active_uniform + " runtime active bound was lost")
    require(zero_readers == 1, "zero array must be read by exactly one bounded loop")
    require(pole_readers == 1, "pole array must be read by exactly one bounded loop")
    labels ∈ list[str] ← ["first", "second"]
    for loop_index in range(2):
        label ∈ str ← labels[loop_index]
        block ∈ str ← loops[loop_index]
        require("atan(" in block, label + " factor loop lost phase evaluation")
        require("log(" in block, label + " factor loop lost log-modulus evaluation")
    phase_count ∈ int ← shader.count("atan(")
    modulus_count ∈ int ← shader.count("log(")
    require(phase_count == 2, "factor phase computation was copied outside the two loops")
    require(modulus_count == 2, "factor log-modulus computation was copied outside the two loops")
    # Operand-only selects remain distinct from branch-local computations.
    operand ∈ str ← r"(?:[A-Za-z_][A-Za-z_0-9]*|-?(?:[0-9]+(?:\.[0-9]*)?)(?:e[+-]?[0-9]+)?)"
    for line in shader_lines:
        if " ? " in line:
            selected_operands ∈ object ← re.search(r"= \(" + operand + r" \? " + operand + r" : " + operand + r"\);$", line)
            require(bool(selected_operands),
                    "analytic continuation evaluated branch work in a GLSL select")
    for operation in ["floor(", "pow(", "smoothstep(", "cos("]:
        require(operation in shader, "analytic continuation shader lost " + operation)
    center_count ∈ int ← shader.count("u_continuation_centers[int(")
    radius_count ∈ int ← shader.count("u_continuation_radii[int(")
    require(center_count >= 24,
            "24 bounded continuation centers were not compiled")
    require(radius_count >= 24,
            "24 bounded continuation radii were not compiled")
    require("0.08" in shader and "0.096" in shader, "charcoal unrevealed palette was lost")
    require("0.98" in shader and "0.95" in shader, "continuation boundary palette was lost")

def main() → int:
    require(BACKEND.is_file(), "backend executable is missing; run make backend")
    require(VERTEX.is_file(), "Wegert fullscreen vertex fixture is missing")
    with tempfile.TemporaryDirectory(prefix="analytic-continuation-") as directory:
        output_dir ∈ object ← Path(directory)
        low_variant ∈ tuple[str, str, object] ← compile_variant(output_dir, "lowp")
        high_variant ∈ tuple[str, str, object] ← compile_variant(output_dir, "highp")
        low_ir ∈ str ← low_variant[0]
        low_shader ∈ str ← low_variant[1]
        low_path ∈ object ← low_variant[2]
        high_ir ∈ str ← high_variant[0]
        high_shader ∈ str ← high_variant[1]
        high_path ∈ object ← high_variant[2]
        require(low_ir == high_ir, "precision policy changed analytic continuation typed IR")
        ir_loop_count ∈ int ← low_ir.count("bounded-loop")
        ir_capacity_count ∈ int ← low_ir.count("< 64 active <")
        require(ir_loop_count == 2,
                "typed analytic continuation IR must contain one zero loop and one pole loop")
        require(ir_capacity_count == 2,
                "typed factor loops lost compile-time or runtime bounds")
        check_shader_shape(low_shader, "lowp")
        check_shader_shape(high_shader, "highp")
        require(normalize_precision(low_shader) == normalize_precision(high_shader),
                "lowp/highp analytic continuation differs by more than precision policy")
        validate_glsl(low_path)
        validate_glsl(high_path)
    print("analytic continuation passed: two bounded factor loops, precision-stable linked GLSL")
    return 0
