	$[ENV.GREASE] $[ENV.FP_RUNTIME] $[ENV.BACKEND_ROOT] ./build/exec/idris2-glsles --cg glsles --source-dir src --output-dir generated src/Example/CoordinatePairing32Grayscale.idr -o coordinate-pairing32-grayscale

